+from pathlib import Path
+
+import chromadb
+from config.config import Config
+
+# 搬家前在旧目录实测的计数，作为"数据没丢"的判据（spec 第十节判据 1）
+PARENT_COUNT = 2
+CHILD_COUNT = 7
+
+
+def test_collection_counts_survived_the_move():
+    # PersistentClient 会把缺失的目录新建成空库，先确认打开的是搬过来的那一份
+    assert (Path(Config.CHROMA_PERSIST_DIR) / "chroma.sqlite3").is_file()
+    client = chromadb.PersistentClient(path=Config.CHROMA_PERSIST_DIR)
+    counts = {c.name: client.get_collection(c.name).count() for c in client.list_collections()}
+    assert counts == {"parent_document": PARENT_COUNT, "child_document": CHILD_COUNT}
