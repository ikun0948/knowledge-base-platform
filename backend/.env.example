# 复制为 backend/.env 后填写。.env 已被 .gitignore 排除，永不入库。
# 注意：D:/AI-python/.env 是其它脚本共用的，本项目不再读它（spec 7.1）。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名（答题与上下文压缩共用一处）；不写则用代码里的默认值 qwen3.7-flash
LLM_MODEL=qwen3.7-flash
# 本地 sentence-transformers 模型目录；换模型必须重建 Chroma 集合
LOCAL_MODEL_PATH=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mydb
# 必须是绝对路径（坑 2）
CHROMA_PERSIST_DIR=/absolute/path/to/backend/data/chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
# 令牌寿命（天）；不写用 30
AUTH_TOKEN_TTL_DAYS=30
# 默认用户 default@local 的初始口令；留空则该账号不可登录（旧数据仍归它）
DEFAULT_USER_PASSWORD=
